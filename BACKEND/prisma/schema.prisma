generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERATOR  
  MANAGER   
  ADMIN     
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum MovementType {
  SUPPLY   
  BLEED    
}

enum SaleStatus {
  OPEN       
  COMPLETED  
  CANCELED   
}

enum PaymentMethod {
  CASH   
  CARD   
  PIX    
}

model User {
  id              String         @id @default(uuid())
  name            String
  password        String
  role            Role           @default(OPERATOR)
  shifts          Shift[]        
  sales           Sale[]        
  authorizations  AuditLog[]     
  cashMovements   CashMovement[] 
  active Boolean @default(true)
  createdAt       DateTime       @default(now())
}

model Shift {
  id              String         @id @default(uuid())
  operatorId      String
  operator        User           @relation(fields: [operatorId], references: [id])
  initialAmount   Decimal        @db.Decimal(10, 2) 
  declaredAmount  Decimal?       @db.Decimal(10, 2) 
  status          ShiftStatus    @default(OPEN)
  openedAt        DateTime       @default(now())
  closedAt        DateTime?
  sales           Sale[]
  movements       CashMovement[]
}

model CashMovement {
  id          String       @id @default(uuid())
  shiftId     String
  shift       Shift        @relation(fields: [shiftId], references: [id])
  userId      String      
  user        User         @relation(fields: [userId], references: [id])
  type        MovementType
  amount      Decimal      @db.Decimal(10, 2)
  reason      String?      
  createdAt   DateTime     @default(now())
}

model Product {
  id            String     @id @default(uuid())
  name          String
  barcode       String?    @unique
  internalCode  String?    @unique
  price         Decimal    @db.Decimal(10, 2) 
  stock         Int        @default(0)
  saleItems     SaleItem[]
}

model Sale {
  id            String       @id @default(uuid())
  shiftId       String
  shift         Shift        @relation(fields: [shiftId], references: [id])
  operatorId    String
  operator      User         @relation(fields: [operatorId], references: [id])
  status        SaleStatus   @default(OPEN)
  totalAmount   Decimal      @default(0) @db.Decimal(10, 2)
  discount      Decimal      @default(0) @db.Decimal(10, 2) 
  finalAmount   Decimal      @default(0) @db.Decimal(10, 2)
  items         SaleItem[]
  payments      Payment[]
  createdAt     DateTime     @default(now()) // Timestamp da venda
}

model SaleItem {
  id            String     @id @default(uuid())
  saleId        String
  sale          Sale       @relation(fields: [saleId], references: [id])
  productId     String
  product       Product    @relation(fields: [productId], references: [id])
  quantity      Int
  unitPrice     Decimal    @db.Decimal(10, 2)
  discount      Decimal    @default(0) @db.Decimal(10, 2)
  totalPrice    Decimal    @db.Decimal(10, 2) 
}

model Payment {
  id            String        @id @default(uuid())
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id])
  
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2) 
}

model AuditLog {
  id            String     @id @default(uuid())
  action        String     
  details       String?
  managerId     String     
  manager       User       @relation(fields: [managerId], references: [id])
  referenceId   String?    
  createdAt     DateTime   @default(now())
}