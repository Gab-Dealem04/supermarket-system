generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERATOR  // Operador de Caixa
  MANAGER   // Gerente/Supervisor
  ADMIN     // Administrador
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum MovementType {
  SUPPLY   // Suprimento
  BLEED    // Sangria
}

enum SaleStatus {
  OPEN       // Aberto (Carrinho)
  COMPLETED  // Concluída
  CANCELED   // Cancelada
}

enum PaymentMethod {
  CASH   // Dinheiro
  CARD   // Cartão (Débito/Crédito)
  PIX    // Pix
}

model User {
  id              String         @id @default(uuid())
  name            String
  password        String
  role            Role           @default(OPERATOR)
  
  // Relacionamentos
  shifts          Shift[]        // Turnos que operou
  sales           Sale[]         // Vendas realizadas
  authorizations  AuditLog[]     // Operações críticas que este usuário (gerente) autorizou
  cashMovements   CashMovement[] // Suprimentos e sangrias registrados

  createdAt       DateTime       @default(now())
}

model Shift {
  id              String         @id @default(uuid())
  operatorId      String
  operator        User           @relation(fields: [operatorId], references: [id])
  
  initialAmount   Decimal        @db.Decimal(10, 2) // Fundo de troco (Abertura)
  declaredAmount  Decimal?       @db.Decimal(10, 2) // Valor declarado pelo operador (Fechamento)
  status          ShiftStatus    @default(OPEN)
  
  openedAt        DateTime       @default(now())
  closedAt        DateTime?
  
  sales           Sale[]
  movements       CashMovement[]
}

model CashMovement {
  id          String       @id @default(uuid())
  shiftId     String
  shift       Shift        @relation(fields: [shiftId], references: [id])
  
  userId      String       // Operador que registrou
  user        User         @relation(fields: [userId], references: [id])
  
  type        MovementType
  amount      Decimal      @db.Decimal(10, 2)
  reason      String?      // Motivo exigido para Sangria
  
  createdAt   DateTime     @default(now())
}

model Product {
  id            String     @id @default(uuid())
  name          String
  barcode       String?    @unique
  internalCode  String?    @unique
  price         Decimal    @db.Decimal(10, 2) // 10 dígitos no total, 2 casas decimais
  stock         Int        @default(0)
  
  saleItems     SaleItem[]
}

model Sale {
  id            String       @id @default(uuid())
  shiftId       String
  shift         Shift        @relation(fields: [shiftId], references: [id])
  
  operatorId    String
  operator      User         @relation(fields: [operatorId], references: [id])
  
  status        SaleStatus   @default(OPEN)
  totalAmount   Decimal      @default(0) @db.Decimal(10, 2)
  discount      Decimal      @default(0) @db.Decimal(10, 2) // Desconto total na venda
  finalAmount   Decimal      @default(0) @db.Decimal(10, 2)
  
  items         SaleItem[]
  payments      Payment[]
  
  createdAt     DateTime     @default(now()) // Timestamp da venda
}

model SaleItem {
  id            String     @id @default(uuid())
  saleId        String
  sale          Sale       @relation(fields: [saleId], references: [id])
  
  productId     String
  product       Product    @relation(fields: [productId], references: [id])
  
  quantity      Int
  unitPrice     Decimal    @db.Decimal(10, 2)
  discount      Decimal    @default(0) @db.Decimal(10, 2) // Desconto específico no item
  
  totalPrice    Decimal    @db.Decimal(10, 2) // (quantity * unitPrice) - discount
}

model Payment {
  id            String        @id @default(uuid())
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id])
  
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2) // Valor pago nesta modalidade
}

model AuditLog {
  id            String     @id @default(uuid())
  action        String     // Ex: "CANCELAMENTO_VENDA", "SANGRIA", "CANCELAMENTO_ITEM"
  details       String?
  
  managerId     String     // Gerente que autorizou
  manager       User       @relation(fields: [managerId], references: [id])
  
  referenceId   String?    // ID da venda, item ou movimentação afetada
  createdAt     DateTime   @default(now())
}